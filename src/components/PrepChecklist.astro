---
import season from '../data/season.json';
import type { Lang } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const prep = season.prep;
const total = prep.groups.reduce((n, g) => n + g.items.length, 0);

type Item = (typeof prep.groups)[number]['items'][number] & {
  desc?: { id: string; en: string };
  when?: { id: string; en: string };
  type?: string;
  /** file name in /public/icons/prep (without .webp) */
  icon?: string;
  /** fallback when no in-game icon is available yet */
  emoji?: string;
};

const copy = {
  id: {
    title: 'Checklist persiapan Season 6',
    progress: 'selesai',
    note: 'Centangan tersimpan di browser kamu saja.',
  },
  en: {
    title: 'Season 6 preparation checklist',
    progress: 'done',
    note: 'Your ticks are saved in this browser only.',
  },
}[lang];
---

<section class="card prep" id="persiapan" data-prep>
  <div class="prep-head">
    <div>
      <h2>🌿 {copy.title}</h2>
      <p class="muted small">{prep.source[lang]}</p>
    </div>
    <div class="prep-progress" aria-live="polite">
      <span><strong data-prep-count>0</strong>/{total} {copy.progress}</span>
      <span class="bar" aria-hidden="true"><span data-prep-bar></span></span>
    </div>
  </div>

  <div class="prep-groups">
    {
      prep.groups.map((g) => (
        <fieldset class="prep-group">
          <legend>{g.title[lang]}</legend>
          {'note' in g && g.note && <p class="muted g-note">{(g.note as { id: string; en: string })[lang]}</p>}
          <ul class="prep-list">
            {(g.items as Item[]).map((item) => (
              <li>
                <label>
                  <input type="checkbox" data-prep-item={item.id} />
                  <span class="box" aria-hidden="true" />
                  <span class="ico" aria-hidden="true">
                    {item.icon ? (
                      <img src={`/icons/prep/${item.icon}.webp`} alt="" width="40" height="40" loading="lazy" decoding="async" />
                    ) : (
                      <span class="emo">{item.emoji ?? '•'}</span>
                    )}
                  </span>
                  <span class="txt">
                    <span class="ttl">
                      <span class="t">{item.title[lang]}</span>
                      {item.when && <span class="badge red">{item.when[lang]}</span>}
                      {item.type && <span class="badge">{item.type}</span>}
                    </span>
                    {item.desc && <span class="muted desc">{item.desc[lang]}</span>}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      ))
    }
  </div>

  <p class="reminder">🌳 {prep.reminder[lang]}</p>
  <p class="muted small note">{copy.note}</p>
</section>

<style>
  .prep {
    scroll-margin-top: 124px; /* keep the title clear of the sticky header on #persiapan */
    --prep-bar-track: var(--surface-2);
    --prep-bar-end: #ff8a8f;
    --prep-ico-ring: rgb(255 255 255 / 0.08);
    --prep-done-badge: 0.6;
  }
  /* Light: visible bar track and a deeper bar end on the white card, a dark
     hairline round the icon tiles, and badges of ticked items not faded (they
     turn into muted outline badges instead, see below). */
  :global(:root[data-theme='light']) .prep {
    --prep-bar-track: var(--forest-700);
    --prep-bar-end: #ec5761;
    --prep-ico-ring: rgb(16 36 26 / 0.1);
    --prep-done-badge: 1;
  }
  .prep h2 {
    margin: 0 0 2px;
    font-size: 1.3rem;
  }
  .small {
    font-size: 0.82rem;
    margin: 0;
  }
  .prep-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px 24px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .prep-progress {
    display: grid;
    justify-items: end;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .prep-progress strong {
    color: var(--putih);
    font-size: 1.1rem;
  }
  .bar {
    display: block;
    width: 160px;
    height: 6px;
    border-radius: 6px;
    background: var(--prep-bar-track);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--merah), var(--prep-bar-end));
    transition: width 0.3s ease;
  }

  .prep-groups {
    /* masonry-like flow: short groups fill the space under shorter columns */
    columns: 300px 3;
    column-gap: 14px;
  }
  .prep-group {
    break-inside: avoid;
    margin: 0 0 14px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    min-width: 0;
  }
  .prep-group legend {
    padding: 0 6px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--forest-200);
  }
  .g-note {
    margin: 0 0 8px;
    font-size: 0.8rem;
  }
  .prep-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .prep-list label {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .prep-list label:hover {
    border-color: var(--forest-600);
  }
  .prep-list input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .box {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 6px;
    border: 2px solid var(--forest-400);
    display: grid;
    place-items: center;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .prep-list input:checked + .box {
    background: var(--merah);
    border-color: var(--merah);
  }
  .prep-list input:checked + .box::after {
    content: '✓';
    color: var(--on-accent);
    font-weight: 900;
    font-size: 0.8rem;
    line-height: 1;
  }
  .prep-list input:focus-visible + .box {
    outline: 2px solid var(--putih);
    outline-offset: 2px;
  }
  .ico {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    overflow: hidden;
    background: var(--forest-900);
    box-shadow: inset 0 0 0 1px var(--prep-ico-ring);
    display: grid;
    place-items: center;
  }
  /* Light: the opaque icon images cover the inset ring, and the pale ones
     blend into the pale row, so frame the tile on top of the image. */
  :global(:root[data-theme='light']) .ico {
    outline: 1px solid var(--prep-ico-ring);
    outline-offset: -1px;
  }
  .ico img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .emo {
    font-size: 1.35rem;
    line-height: 1;
  }
  .prep-list input:checked ~ .ico {
    opacity: 0.55;
    filter: grayscale(0.6);
  }
  .txt {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .ttl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .desc {
    font-size: 0.82rem;
  }
  .prep-list input:checked ~ .txt .t {
    text-decoration: line-through;
    text-decoration-color: var(--merah);
    color: var(--muted);
  }
  .prep-list input:checked ~ .txt .badge {
    opacity: var(--prep-done-badge);
  }
  /* Light: white text on a faded red badge cannot reach AA, so badges of
     ticked items become plain muted outlines (5.9:1) instead of fading. */
  :global(:root[data-theme='light']) .prep-list input:checked ~ .txt .badge {
    background: var(--surface);
    border-color: var(--border);
    color: var(--muted);
  }
  .reminder {
    margin: 2px 0 0;
    padding: 10px 14px;
    border-left: 4px solid var(--merah);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--surface-2);
    font-size: 0.9rem;
  }
  .note {
    margin-top: 10px;
  }
</style>

<script>
  const KEY = 'rimba.prep.s6';
  for (const root of document.querySelectorAll<HTMLElement>('[data-prep]')) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-prep-item]')];
    const count = root.querySelector<HTMLElement>('[data-prep-count]')!;
    const bar = root.querySelector<HTMLElement>('[data-prep-bar]')!;
    let done = new Set<string>();
    try {
      done = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
    } catch {}
    const sync = () => {
      const n = boxes.filter((b) => b.checked).length;
      count.textContent = String(n);
      bar.style.width = (n / boxes.length) * 100 + '%';
    };
    boxes.forEach((b) => {
      b.checked = done.has(b.dataset.prepItem!);
      b.addEventListener('change', () => {
        if (b.checked) done.add(b.dataset.prepItem!);
        else done.delete(b.dataset.prepItem!);
        try {
          localStorage.setItem(KEY, JSON.stringify([...done]));
        } catch {}
        sync();
      });
    });
    sync();
  }
</script>
