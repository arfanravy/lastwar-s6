---
// The 3D map now lives on the Faction Reveal page. This keeps old links
// (including deep links like /id/map/#1196) working.
import type { Lang } from '../../config';
import { langPaths, localePath } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const target = localePath(lang, 'faction-reveal/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Faction Reveal</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.hash);
    </script>
    <style>
      body { background: #07170f; color: #fff; font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: #fff; }
    </style>
  </head>
  <body>
    <p><a href={target}>Faction Reveal →</a></p>
  </body>
</html>
