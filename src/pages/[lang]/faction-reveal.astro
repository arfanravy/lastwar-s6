---
import Base from '../../layouts/Base.astro';
import RainforestMap from '../../components/RainforestMap.astro';
import reveal from '../../data/faction-reveal.json';
import type { Lang } from '../../config';
import { formatDate, langPaths, useTranslations } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const copy = {
  id: {
    title: 'Faction Reveal Tracker',
    lead: 'Pembagian 8 server Season 6 ke faksi Deepwood (rusa) dan Wetland (buaya). Klik warzone di peta untuk melihat grup, peringkat, faksi, dan tetangganya; tombol "Hasil faksi" membalik hasil untuk simulasi.',
    stageEnds: 'Tahap reveal berakhir dalam',
    source: 'Sumber: screenshot in-game',
  },
  en: {
    title: 'Faction Reveal Tracker',
    lead: 'How the 8 Season 6 servers split into the Deepwood (deer) and Wetland (crocodile) factions. Click a warzone on the map to see its group, rank, faction and neighbours; the "Faction result" button flips the outcome as a simulation.',
    stageEnds: 'Reveal stage ends in',
    source: 'Source: in-game screenshot',
  },
}[lang];
---

<Base lang={lang} route="faction-reveal/" title={copy.title} description={copy.lead}>
  <header class="page-head">
    <span class="eyebrow">Season 6 · Faction Awards</span>
    <h1>{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>

  <div class="status card">
    <div>
      <span class="muted small">
        {copy.stageEnds}
        {reveal.stageEndsAtEstimated && <span class="badge">{t('common.estimated')}</span>}
      </span>
      <div
        class="countdown"
        data-countdown={reveal.stageEndsAt}
        data-day-unit={t('time.dayUnit')}
        data-ended={t('time.ended')}
      >
        --
      </div>
    </div>
    <div class="muted small src">
      <div>{t('common.updated')}: {formatDate(reveal.updatedAt, lang)}</div>
      <div>{copy.source}</div>
    </div>
  </div>

  <section class="section">
    <RainforestMap lang={lang} mode="full" />
  </section>
</Base>

<style>
  .status {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }
  .small {
    font-size: 0.85rem;
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .src {
    display: block;
    text-align: right;
  }
  @media (max-width: 640px) {
    .src {
      text-align: left;
    }
  }
</style>
