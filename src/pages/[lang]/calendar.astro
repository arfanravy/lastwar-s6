---
import Base from '../../layouts/Base.astro';
import WarTimeRules from '../../components/WarTimeRules.astro';
import { SITE, type Lang } from '../../config';
import { langPaths, localePath, useTranslations } from '../../i18n/ui';
import {
  CAT_LABEL,
  CATS,
  DAY,
  LAST_VERIFIED,
  START_ESTIMATED,
  dayStart,
  expand,
  fmtRange,
  fmtServerDay,
  fmtServerTime,
  weeks,
  type Occurrence,
} from '../../lib/calendar';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const occ = expand(lang);
const icsPath = localePath(lang, 's6-calendar.ics');
const icsUrl = new URL(icsPath, Astro.site).href;
const webcal = icsUrl.replace(/^https?:/, 'webcal:');

const copy = {
  id: {
    title: 'Kalender Season 6',
    lead: 'Jadwal event Lost Rainforest per minggu, dengan hitung mundur. Jam ditampilkan dalam waktu server (UTC-2) dan zona waktu HP kamu.',
    now: 'Sekarang',
    reset: 'Reset harian dalam',
    upTitle: 'Sedang berlangsung & berikutnya',
    addTitle: 'Masukkan ke kalender HP',
    addLead: 'Event muncul di Google Calendar / kalender HP, dengan pengingat 15 menit sebelum event yang ada jamnya dan pengingat pasang Shield sebelum hari Sabtu.',
    subscribe: 'Langganan (update otomatis)',
    download: 'Unduh file .ics',
    addHint: 'Google Calendar di komputer: Setelan → Tambahkan kalender → Dari URL, lalu tempel link ini:',
    copy: 'Salin',
    copied: 'Tersalin',
    filter: 'Tampilkan',
    thisWeek: 'Sepanjang minggu',
    today: 'Hari ini',
    nowBadge: 'Minggu ini',
    allDay: 'seharian',
    tbc: 'perkiraan',
    noEvents: 'Belum ada event yang tercatat.',
    estimated: 'Tanggal dihitung dari timer in-game server #1196 (pra-musim selesai {date}). Server lain bisa bergeser sedikit, dan jam jendela perang ditentukan in-game.',
    source: 'Sumber: layar Rules in-game, panduan komunitas lastwartutorial.com, dan panduan aliansi MAAX. Diperiksa {date}.',
    phase: { before: 'Sebelum pra-musim', pre: 'Pra-musim', season: 'Season · Minggu', celebration: 'Celebration · Minggu', after: 'Season 6 selesai', day: 'hari' },
  },
  en: {
    title: 'Season 6 Calendar',
    lead: 'Lost Rainforest events week by week, with countdowns. Times are shown in server time (UTC-2) and your device’s time zone.',
    now: 'Now',
    reset: 'Daily reset in',
    upTitle: 'Live now & up next',
    addTitle: 'Add to your phone calendar',
    addLead: 'Events appear in Google Calendar / your phone calendar, with a reminder 15 minutes before timed events and a Shield reminder before each Saturday.',
    subscribe: 'Subscribe (auto-updates)',
    download: 'Download .ics file',
    addHint: 'Google Calendar on desktop: Settings → Add calendar → From URL, then paste this link:',
    copy: 'Copy',
    copied: 'Copied',
    filter: 'Show',
    thisWeek: 'All week',
    today: 'Today',
    nowBadge: 'This week',
    allDay: 'all day',
    tbc: 'estimated',
    noEvents: 'No events recorded yet.',
    estimated: 'Dates are based on server #1196’s in-game timer (pre-season ends {date}). Other servers may shift slightly, and war-window times are set in game.',
    source: 'Sources: the in-game Rules screen, lastwartutorial.com community guides and the MAAX alliance guide. Checked {date}.',
    phase: { before: 'Before pre-season', pre: 'Pre-season', season: 'Season · Week', celebration: 'Celebration · Week', after: 'Season 6 is over', day: 'day' },
  },
}[lang];

const labels = {
  live: lang === 'id' ? 'Sedang berlangsung' : 'Live now',
  next: lang === 'id' ? 'Berikutnya' : 'Up next',
  startsIn: lang === 'id' ? 'mulai dalam' : 'starts in',
  endsIn: lang === 'id' ? 'berakhir dalam' : 'ends in',
  allDay: copy.allDay + (lang === 'id' ? ' (waktu server)' : ' (server time)'),
  server: 'server',
  empty: copy.noEvents,
  tbc: copy.tbc,
};

const weekCards = weeks(lang).map((w) => {
  const items = occ.filter((o) => o.phase === w.phase && (w.phase === 'celebration' || o.week === w.week));
  const weekLevel = items.filter((o) => o.precision === 'week');
  const days = [1, 2, 3, 4, 5, 6, 7]
    .map((d) => ({
      d,
      start: dayStart(w.phase, w.week, d),
      items: items.filter((o) => o.day === d),
    }))
    .filter((x) => x.items.length);
  return { ...w, weekLevel, days };
});

const iso = (ts: number) => new Date(ts).toISOString();
const timeChip = (o: Occurrence) =>
  o.precision === 'time' ? `${fmtServerTime(o.start, lang)}${o.end > o.start ? '–' + fmtServerTime(o.end, lang) : ''}` : copy.allDay;
const estimatedNote = copy.estimated.replace('{date}', fmtServerDay(dayStart('season', 1), lang));
---

<Base lang={lang} route="calendar/" title={copy.title} description={copy.lead}>
  <header class="page-head">
    <span class="eyebrow">Season 6 · Lost Rainforest</span>
    <h1>{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>

  <div class="cal" data-cal data-lang={lang} data-labels={JSON.stringify({ phase: copy.phase })}>
    <section class="card cal-now">
      <div class="now-pos">
        <span class="muted small">{copy.now}</span>
        <strong data-now-pos>—</strong>
      </div>
      <div class="clock-row">
        <div>
          <span>{t('time.server')}</span>
          <span class="mono" data-clock="server" data-offset={SITE.serverUtcOffset}>--:--:--</span>
        </div>
        <div>
          <span>{t('time.local')}</span>
          <span class="mono" data-clock="local">--:--:--</span>
        </div>
        <div>
          <span>{copy.reset}</span>
          <span class="mono" data-reset>--:--:--</span>
        </div>
      </div>
    </section>

    <div class="grid-2 section top-grid">
      <section class="card">
        <h2>{copy.upTitle}</h2>
        <ol class="up-list" data-upcoming data-up-labels={JSON.stringify(labels)}>
          <li class="up-empty muted">…</li>
        </ol>
      </section>

      <section class="card add">
        <h2>📅 {copy.addTitle}</h2>
        <p class="muted">{copy.addLead}</p>
        <div class="add-btns">
          <a class="btn" href={webcal}>{copy.subscribe}</a>
          <a class="btn ghost" href={icsPath} download="last-war-s6.ics">{copy.download}</a>
        </div>
        <p class="muted small hint">{copy.addHint}</p>
        <div class="copy-row">
          <input type="text" readonly value={icsUrl} aria-label="iCal URL" data-ics-url />
          <button type="button" class="btn ghost" data-copy data-copied={copy.copied}>{copy.copy}</button>
        </div>
      </section>
    </div>

    <div class="section">
      <WarTimeRules lang={lang} />
    </div>

    <div class="filters section" role="group" aria-label={copy.filter}>
      <span class="muted small">{copy.filter}:</span>
      {
        CATS.map((c) => (
          <button type="button" class="chip" data-cat={c} data-filter={c} aria-pressed="true">
            <span class="cat-dot" />
            {CAT_LABEL[lang][c]}
          </button>
        ))
      }
    </div>

    <div class="weeks">
      {
        weekCards.map((w) => (
          <details class="wk card" open data-start={w.start} data-end={w.end}>
            <summary>
              <span class="wk-label">{w.label}</span>
              <span class="wk-range muted">{fmtRange(w, lang)}</span>
              <span class="badge red wk-now" hidden>
                {copy.nowBadge}
              </span>
            </summary>
            <div class="wk-body">
              {w.weekLevel.length > 0 && (
                <div class="day wk-level">
                  <div class="day-label">{copy.thisWeek}</div>
                  <ul class="items">
                    {w.weekLevel.map((o) => (
                      <li class="item" data-cat={o.cat}>
                        <span class="cat-dot" />
                        <div>
                          <div class="it-title">
                            {o.title}
                            {o.note && <span class="up-note"> · {o.note}</span>}
                          </div>
                          {o.desc && <div class="it-desc">{o.desc}</div>}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {w.days.map((d) => (
                <div class="day" data-day-start={d.start} data-day-end={d.start + DAY}>
                  <div class="day-label">
                    {fmtServerDay(d.start, lang)}
                    <span class="badge today" hidden>
                      {copy.today}
                    </span>
                  </div>
                  <ul class="items">
                    {d.items.map((o) => (
                      <li class="item" data-cat={o.cat}>
                        <span class="cat-dot" />
                        <div>
                          <div class="it-title">
                            {o.title}
                            {o.note && <span class="up-note"> · {o.note}</span>}
                            {o.tbc && <span class="badge warn up-tbc">{copy.tbc}</span>}
                          </div>
                          <div class="it-time">
                            <span class="mono">{timeChip(o)}</span>
                            {o.precision === 'time' ? (
                              <span class="muted">
                                {' '}
                                server · <span data-local={iso(o.start)} />
                              </span>
                            ) : (
                              <span class="muted"> (server)</span>
                            )}
                          </div>
                          {o.desc && <div class="it-desc">{o.desc}</div>}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {w.weekLevel.length === 0 && w.days.length === 0 && <p class="muted">{copy.noEvents}</p>}
            </div>
          </details>
        ))
      }
    </div>

    <p class="muted small note">
      {START_ESTIMATED && <span class="badge">{t('common.estimated')}</span>}
      {estimatedNote}
    </p>
    <p class="muted small note">{copy.source.replace('{date}', LAST_VERIFIED)}</p>
  </div>
</Base>

<style>
  .small {
    font-size: 0.82rem;
  }
  .cal-now {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
  }
  .now-pos {
    display: grid;
    gap: 2px;
  }
  .now-pos strong {
    font-size: 1.35rem;
  }
  .top-grid {
    align-items: start;
  }
  .top-grid h2,
  .add h2 {
    font-size: 1.1rem;
    margin: 0 0 12px;
  }
  .add p {
    margin: 0 0 12px;
  }
  .add-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .hint {
    margin-bottom: 6px !important;
  }
  .copy-row {
    display: flex;
    gap: 8px;
  }
  .copy-row input {
    flex: 1;
    min-width: 0;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-950);
    color: var(--forest-200);
    font: 0.8rem var(--mono);
  }
  .copy-row .btn {
    padding: 8px 14px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--forest-600);
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }
  .chip[aria-pressed='false'] {
    opacity: 0.45;
    background: transparent;
  }
  .cal.hide-war :global([data-cat='war']:not(.chip)),
  .cal.hide-altar :global([data-cat='altar']:not(.chip)),
  .cal.hide-hero :global([data-cat='hero']:not(.chip)),
  .cal.hide-event :global([data-cat='event']:not(.chip)),
  .cal.hide-season :global([data-cat='season']:not(.chip)) {
    display: none;
  }

  .weeks {
    display: grid;
    gap: 12px;
  }
  .wk {
    padding: 0;
    overflow: hidden;
  }
  .wk summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }
  .wk summary::-webkit-details-marker {
    display: none;
  }
  .wk summary::before {
    content: '▸';
    color: var(--muted);
    transition: transform 0.15s;
  }
  .wk[open] summary::before {
    transform: rotate(90deg);
  }
  .wk-label {
    font-weight: 800;
    font-size: 1.05rem;
  }
  .wk-range {
    font-size: 0.85rem;
  }
  .wk.is-now {
    border-color: var(--merah);
    box-shadow: 0 0 0 1px var(--merah);
  }
  .wk.is-past summary {
    opacity: 0.6;
  }
  .wk-body {
    display: grid;
    gap: 10px;
    padding: 0 18px 16px;
  }
  .day {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 14px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .day-label {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--forest-200);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .day.is-today .day-label {
    color: var(--putih);
  }
  .badge.today {
    background: var(--merah);
    border-color: var(--merah);
    color: var(--putih);
  }
  .day.is-past {
    opacity: 0.55;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .item .cat-dot {
    margin-top: 6px;
  }
  .it-title {
    font-weight: 700;
    font-size: 0.93rem;
  }
  .it-time {
    font-size: 0.8rem;
  }
  .it-time .mono {
    color: var(--putih);
    font-weight: 700;
  }
  .it-desc {
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .day {
      grid-template-columns: minmax(0, 1fr);
    }
    .wk summary {
      padding: 12px 14px;
    }
    .wk-body {
      padding: 0 14px 14px;
    }
  }
  .note {
    margin: 16px 0 0;
    display: flex;
    gap: 8px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .note + .note {
    margin-top: 4px;
  }
</style>

<script>
  import type { Lang } from '../../config';
  import { fmtCountdown, fmtLocalTime, nextReset, position } from '../../lib/calendar';
  import { mountUpcoming, type UpcomingLabels } from '../../lib/calendar-client';

  const FILTER_KEY = 'rimba.cal.hidden';

  for (const root of document.querySelectorAll<HTMLElement>('[data-cal]')) {
    const lang = root.dataset.lang as Lang;
    const { phase: P } = JSON.parse(root.dataset.labels!) as { phase: Record<string, string> };

    // Local times for timed events (visitor's own time zone)
    root.querySelectorAll<HTMLElement>('[data-local]').forEach((e) => {
      e.textContent = fmtLocalTime(Date.parse(e.dataset.local!), lang);
    });

    // Live / next list
    const up = root.querySelector<HTMLElement>('[data-upcoming]')!;
    mountUpcoming(up, lang, { next: 6, live: 4, labels: JSON.parse(up.dataset.upLabels!) as UpcomingLabels });

    // "Now" position, daily reset, current week/day highlighting
    const posEl = root.querySelector<HTMLElement>('[data-now-pos]')!;
    const resetEl = root.querySelector<HTMLElement>('[data-reset]')!;
    const weeks = [...root.querySelectorAll<HTMLDetailsElement>('details.wk')];
    const days = [...root.querySelectorAll<HTMLElement>('.day[data-day-start]')];
    let lastDayKey = '';
    const tick = () => {
      const now = Date.now();
      const pos = position(now);
      posEl.textContent =
        pos.phase === 'before' || pos.phase === 'after'
          ? P[pos.phase]
          : `${P[pos.phase]} ${pos.week} · ${P.day} ${pos.day}`;
      resetEl.textContent = fmtCountdown(nextReset(now) - now, lang);

      const dayKey = `${pos.phase}-${'week' in pos ? pos.week : ''}-${'day' in pos ? pos.day : ''}`;
      if (dayKey === lastDayKey) return;
      const first = lastDayKey === '';
      lastDayKey = dayKey;
      weeks.forEach((w) => {
        const s = Number(w.dataset.start);
        const e = Number(w.dataset.end);
        const isNow = s <= now && now < e;
        const past = e <= now;
        w.classList.toggle('is-now', isNow);
        w.classList.toggle('is-past', past);
        w.querySelector<HTMLElement>('.wk-now')!.hidden = !isNow;
        if (first) w.open = !past; // collapse finished weeks on load
      });
      days.forEach((d) => {
        const s = Number(d.dataset.dayStart);
        const e = Number(d.dataset.dayEnd);
        d.classList.toggle('is-today', s <= now && now < e);
        d.classList.toggle('is-past', e <= now);
        d.querySelector<HTMLElement>('.today')!.hidden = !(s <= now && now < e);
      });
    };
    tick();
    setInterval(tick, 1000);

    // Category filters (remembered per browser)
    let hidden = new Set<string>();
    try {
      hidden = new Set(JSON.parse(localStorage.getItem(FILTER_KEY) || '[]'));
    } catch {}
    const applyFilters = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        const c = b.dataset.filter!;
        b.setAttribute('aria-pressed', String(!hidden.has(c)));
        root.classList.toggle('hide-' + c, hidden.has(c));
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.addEventListener('click', () => {
        const c = b.dataset.filter!;
        if (hidden.has(c)) hidden.delete(c);
        else hidden.add(c);
        try {
          localStorage.setItem(FILTER_KEY, JSON.stringify([...hidden]));
        } catch {}
        applyFilters();
      }),
    );
    applyFilters();

    // Copy iCal URL
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    const urlInput = root.querySelector<HTMLInputElement>('[data-ics-url]');
    copyBtn?.addEventListener('click', async () => {
      if (!urlInput) return;
      try {
        await navigator.clipboard.writeText(urlInput.value);
      } catch {
        urlInput.select(); // clipboard API blocked: leave the URL selected for manual copy
        return;
      }
      const old = copyBtn.textContent;
      copyBtn.textContent = copyBtn.dataset.copied ?? old;
      setTimeout(() => (copyBtn.textContent = old), 1500);
    });
  }
</script>
